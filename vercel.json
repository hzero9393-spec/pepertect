{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && next build",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    }
  }
}
